# --- Supabase (Project Settings > API) ---------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# The anon / publishable key. Safe for the browser; RLS protects the data.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# --- Site ---------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Contact form -------------------------------------------------------
# Random string used to hash visitor IPs for rate limiting (never store raw IPs).
# Generate one with: openssl rand -hex 32
CONTACT_HASH_SALT=change-me

# NOTE: No service-role key is needed. Admin access is enforced by RLS using the
# public.admin_users allowlist (see README), so no privileged secret ever
# lives in this app.

#CONTACT_HASH_SALT is a secret random string used by your portfolio's contact form to create a hashed representation of visitors' IP addresses.

#In your project, it helps with rate limiting — preventing someone from repeatedly submitting contact forms.
